#!/usr/bin/env python3
"""Launch Splice in a dedicated Linux application window."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys
import threading

from server import create_server


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=47834)
    args = parser.parse_args()
    choices = ("chromium", "chromium-browser", "google-chrome-stable", "google-chrome")
    browser = next((shutil.which(name) for name in choices if shutil.which(name)), None)
    if not browser:
        sys.exit("Install Chromium or Google Chrome, or run python3 server.py to use your browser.")
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        sys.exit("Splice needs a graphical Linux session. Run python3 server.py for browser access.")
    profile = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "splice/browser"
    profile.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        server = create_server(args.port)
    except OSError as error:
        sys.exit(f"Could not open Splice on port {args.port}: {error}. Check for an existing window.")
    with server:
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            return subprocess.run([
                browser, f"--app=http://127.0.0.1:{server.server_port}/",
                f"--user-data-dir={profile}", "--no-first-run", "--disable-sync",
                "--class=Splice", "--window-size=1480,960",
            ], check=False).returncode
        finally:
            server.shutdown()
            thread.join()


if __name__ == "__main__":
    sys.exit(main())
